{
  "ci": {
    "collect": {
      "url": [
        "https://i.nolcool.com/",
        "https://i.nolcool.com/location/",
        "https://i.nolcool.com/booking/",
        "https://i.nolcool.com/rooms/",
        "https://i.nolcool.com/hours/",
        "https://i.nolcool.com/parking/",
        "https://i.nolcool.com/access-1/",
        "https://i.nolcool.com/vip-1/",
        "https://i.nolcool.com/reviews/",
        "https://i.nolcool.com/faq/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "uses-text-compression": "off",
        "csp-xss": "off",
        "uses-rel-preconnect": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
